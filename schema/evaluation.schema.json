{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XCITY AI Competition - evaluation.json",
  "type": "object",
  "required": [
    "gates",
    "dimensions"
  ],
  "properties": {
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "checks"
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_en"
        ],
        "properties": {
          "weight": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
